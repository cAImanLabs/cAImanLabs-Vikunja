{
  "name": "caimandesk-desktop",
  "version": "v0.1.0",
  "description": "cAImanDesk's frontend as a standalone desktop application.",
  "main": "main.js",
  "repository": "https://github.com/cAImanLabs/cAImanLabs-Vikunja",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.19.0",
  "author": {
    "name": "cAImanLabs"
  },
  "homepage": "https://github.com/cAImanLabs/cAImanLabs-Vikunja",
  "scripts": {
    "build:frontend": "cd ../frontend && pnpm run build && cd ../desktop && rm -rf frontend && cp -r ../frontend/dist frontend",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never"
  },
  "build": {
    "appId": "io.vikunja.desktop",
    "files": [
      "**/*",
      "preload-quick-entry.js"
    ],
    "productName": "cAImanDesk Desktop",
    "artifactName": "${productName}-${version}.${ext}",
    "icon": "build/icon.icns",
    "protocols": {
      "name": "cAImanDesk Desktop",
      "schemes": ["vikunja-desktop"]
    },
    "linux": {
      "target": [
        "deb",
        "AppImage",
        "snap",
        "pacman",
        "apk",
        "freebsd",
        "rpm",
        "zip",
        "tar.gz"
      ],
      "category": "Productivity"
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "msi",
        "zip"
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "unzipper": "0.12.5"
  },
  "dependencies": {
    "express": "5.2.1"
  }
}
